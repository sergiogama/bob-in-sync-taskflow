# TaskFlow application
API_PORT=3001
DATABASE_PATH=./data/taskflow.db

# Notifications: log (local preview) or resend (real delivery)
NOTIFICATION_MODE=log
NOTIFICATION_POLL_MS=5000
# Optional safety override for development, e.g. delivered@resend.dev
NOTIFICATION_RECIPIENT_OVERRIDE=

# Required only when NOTIFICATION_MODE=resend
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=TaskFlow <onboarding@resend.dev>
RESEND_REPLY_TO=
