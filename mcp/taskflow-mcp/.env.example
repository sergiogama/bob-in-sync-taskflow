# TaskFlow MCP Server — environment variables
# Copy this file to .env and fill in your credentials.
# The real .env file is excluded from Git.

# Base URL of the TaskFlow API (optional — defaults to http://127.0.0.1:3101)
TASKFLOW_API_URL=http://127.0.0.1:3101

# TaskFlow account credentials used by the MCP server to authenticate
TASKFLOW_EMAIL=your-email@example.com
TASKFLOW_PASSWORD=your-password
